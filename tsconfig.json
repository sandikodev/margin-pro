{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "bun"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@client/*": [
        "./src/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@server/*": [
        "./src/server/*"
      ],
      "@shared/*": [
        "./src/lib/shared/*"
      ],
      "@utils/*": [
        "./src/lib/utils/*"
      ],
      "@framework": [
        "./packages/koda/packages/server/src/index.ts"
      ],
      "@framework/*": [
        "./packages/koda/packages/server/src/*"
      ],
      "@koda/core": [
        "./packages/koda/packages/core/src/index.ts"
      ],
      "@koda/ui": [
        "./packages/koda/packages/ui/src/index.ts"
      ],
      "@koda/signals": [
        "./packages/koda/packages/signals/src/index.ts"
      ],
      "@koda/runtime": [
        "./packages/koda/packages/runtime/src/index.tsx"
      ],
      "@apex/*": [
        "./.koda/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}