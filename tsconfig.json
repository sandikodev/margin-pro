{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "bun"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@root/*": [
        "./src/*"
      ],
      "@core/*": [
        "./src/core/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@components/*": [
        "./src/core/ui/*"
      ],
      "@hooks/*": [
        "./src/core/hooks/*"
      ],
      "@context/*": [
        "./src/core/context/*"
      ],
      "@legacy/*": [
        "./src/_legacy/*"
      ],
      "@server/*": [
        "./src/server/*"
      ],
      "@framework/dx": [
        "./packages/koda/packages/core/src/dx/index.ts"
      ],
      "@framework": [
        "./packages/koda/packages/server/src/index.ts"
      ],
      "@framework/*": [
        "./packages/koda/packages/server/src/*"
      ],
      "@koda/core": [
        "./packages/koda/packages/core/src/index.ts"
      ],
      "@koda/core/*": [
        "./packages/koda/packages/core/src/*"
      ],
      "@koda/ui": [
        "./packages/koda/packages/ui/src/index.ts"
      ],
      "@koda/ui/*": [
        "./packages/koda/packages/ui/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}