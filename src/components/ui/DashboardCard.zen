/**
 * ⚡ Zenith Component: DashboardCard (.zen)
 * Philosophy: Rigid, Declarative, Institutional.
 * Inspired by Flutter Widgets.
 */

Container {
    padding: '20';
    radius: 'lg';
    background: 'slate-900';
    display: 'flex';
    direction: 'column';
    gap: '16';

    Row {
        justify: 'between';
        align: 'center';

        Text {
            value: 'Total Revenue';
            color: 'slate-400';
            size: 'sm';
            weight: 'medium';
        }

        Icon {
            name: 'TrendingUp';
            color: 'emerald-500';
        }
    }

    Column {
        gap: '4';

        Text {
            value: 'Rp 45.000.000';
            color: 'white';
            size: '2xl';
            weight: 'bold';
        }

        Text {
            value: '+12.5% from last month';
            color: 'emerald-400';
            size: 'xs';
        }
    }
}
